{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "plane": {
      "type": "streamable-http",
      "url": "https://plane.mdropwork.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "plane:read",
              "plane:write"
            ]
          }
        }
      }
    }
  }
}
