{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	encode zstd gzip

	# Per-client-IP rate limiting for page requests. Hashed build assets are
	# excluded: the first load fetches JS/CSS chunks, and users
	# behind one NAT/gateway IP would otherwise hit 429 almost immediately.
	rate_limit {
		zone pages {
			match {
				not path /assets/*
			}
			key {client_ip}
			events 300
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# Content-hashed build assets are safe to cache immutably.
	@hashed_assets path /assets/*
	header @hashed_assets {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# SPA HTML shell and version manifest should revalidate on each navigation.
	@no_cache {
		not path /assets/*
		not path /mcp-connect /mcp-connect/*
	}
	header @no_cache {
		Cache-Control "no-cache"
	}

	@oauth path /mcp-connect /mcp-connect/*
	header @oauth {
		Cache-Control "no-store"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
