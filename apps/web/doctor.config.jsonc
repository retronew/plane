{
  // React Doctor suppressions that cannot be expressed as a code fix.
  //
  // This file is resolved per project, so its globs are relative to `apps/web`.
  // Rule keys are react-doctor's own ids (`react-doctor/<rule>`) — the ones `pnpm doctor`
  // reports. An inline `oxlint-disable` comment has to name BOTH keys to satisfy oxlint and
  // react-doctor at once:
  //   // oxlint-disable-next-line jsx_a11y/no-autofocus react-doctor/no-autofocus -- reason
  //
  // Everything not listed here is fixed in code.
  "ignore": {
    "files": [
      // Generated service-worker bundles: not authored source, regenerated by the build.
      "public/sw.js",
      "public/workbox-*.js",
    ],
    "overrides": [
      {
        // React Router route modules: `meta`, `clientLoader` and `clientMiddleware` are the
        // framework's own exports, so a route file necessarily exports non-components. Fast
        // Refresh cannot preserve state across them, but the router convention wins.
        "files": ["app/**"],
        "rules": ["react-doctor/only-export-components"],
      },
    ],
  },
}
