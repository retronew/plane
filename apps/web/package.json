    "build:skills": "node ../../plugins/plane-workflow/portable/build.mjs && node --test ../../plugins/plane-workflow/portable/distribution.test.mjs ../../plugins/plane-workflow/portable/marketplace.test.mjs",
    "build": "pnpm run build:skills && react-router build",
    "preview": "pnpm run build && serve -s build/client -l 3000",
    "start": "serve -s build/client -l 3000",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf .react-router && rm -rf node_modules && rm -rf dist && rm -rf build",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "react-router typegen && tsc --noEmit",
    "check:format": "oxfmt --check .",
