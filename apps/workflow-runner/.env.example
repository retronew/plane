# Copy these values into the process environment when running outside Docker.
# Required; generate separately: openssl rand -hex 32
WORKFLOW_RUNNER_SERVICE_TOKEN=
# Must be one trusted origin; request body cannot choose a different host/port.
WORKFLOW_RUNNER_BROKER_ORIGIN=http://localhost:8000
WORKFLOW_RUNNER_MAX_CONCURRENT=2
HOST=127.0.0.1
PORT=8080
