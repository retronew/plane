# Root env configures Docker infrastructure; API settings live in apps/api/.env.
# API rate limits are configured in apps/api/.env.

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_DB="plane"

# Required by REDIS_URL interpolation in apps/api/.env
REDIS_HOST="plane-redis"

# RabbitMQ Settings
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# MinIO credentials and bucket; API storage settings live in apps/api/.env
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880

# Caddy options retained for custom proxy setups; root Compose does not pass these to proxy.
# If SSL Cert to be generated, set CERT_EMAIL="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=

# Workflow Runner (shared by API/worker and the isolated runner; generate: openssl rand -hex 32)
# Required for scripts. Do not reuse SECRET_KEY or expose in frontend env.
WORKFLOW_RUNNER_SERVICE_TOKEN=
